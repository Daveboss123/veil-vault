{
  "name": "veil-vault-video",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion demo video for Veil Vault",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "voiceover": "node scripts/voiceover.mjs --force",
    "audio": "node scripts/make-audio.mjs",
    "render": "remotion render VeilVaultDemo out/veil-vault-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=4",
    "still": "remotion still VeilVaultThumbnail out/thumbnail-1080.png --frame=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "^4.0.539",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kokoro-js": "^1.2.1",
    "typescript": "^5.9.3"
  }
}
